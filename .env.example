# ==============================================================================
# AI Lead Operations Agent — Environment Configuration Template
# All secrets must be provided securely via environment or secret manager.
# NEVER commit populated production secrets to source control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Core Security & RBAC
# Generate a high-entropy secret in production (e.g. openssl rand -hex 32)
API_SECRET_KEY=change-me-to-a-secure-random-64-character-string-in-production
AUTH_TOKEN_EXPIRE_MINUTES=1440
WEBHOOK_HMAC_SECRET=change-me-to-a-secure-hmac-sha256-shared-secret

# Persistence Configuration
# Production Target: postgresql+asyncpg://user:password@localhost:5432/lead_ops
# Local Development Fallback: sqlite+aiosqlite:///./lead_ops.db
DATABASE_URL=sqlite+aiosqlite:///./lead_ops.db

# n8n Automation Engine Settings
# Target instance: Self-hosted n8n instance
N8N_BASE_URL=https://n8n.example.com
# Separate qualification webhook — DO NOT point to /webhook/dispatch-outreach
N8N_QUALIFICATION_WEBHOOK_PATH=/webhook/lead-qualification
N8N_WEBHOOK_TIMEOUT_SECONDS=30
N8N_MAX_RETRIES=3

# External Outreach Guard
# Safety mechanism: External message dispatching is strictly disabled in Release 1
ENABLE_EXTERNAL_OUTREACH=false
